#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

// Include these at top level (NOT inside 'behaviors')
#include "macros.dtsi"
// #include "version.dtsi"

#define _BASE   0
#define _KP     1
#define _FN     2
#define _MOD    3
#define _UML    4   // umlaut
#define _SYMB   5   // coding symbols 
#define _MOUSE  6
#define _NAV    7   // navigation/editing

/ {
  behaviors {

    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      label = "HOMEROW_MODS";
      #binding-cells = <2>;
      tapping-term-ms = <200>;
      flavor = "balanced";
      bindings = <&kp>, <&kp>; // we pass (MOD, KEY) each time we use &hm
    };

    // mod-morph for A/Ä, O/Ö, U/Ü
    ae_morph: ae_morph {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      bindings = <&win_ae &win_AE>;
    };
    oe_morph: oe_morph {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      bindings = <&win_oe &win_OE>;
    };
    ue_morph: ue_morph {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      bindings = <&win_ue &win_UE>;
    };

    // mod-morph for paired symbols (Shift switches the pair)
    paren_brack: paren_brack {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      bindings = <&macro_parens &macro_brackets>;
    };
    brace_angle: brace_angle {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      bindings = <&macro_braces &macro_angles>;
    };
    quote_morph: quote_morph {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      bindings = <&macro_quotes &macro_dquotes>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3      &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &sl _UML                                                         &mo _NAV   &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &sl _SYMB       &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &tog _MOUSE &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp APOSTROPHE
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                                &kp N  &kp M  &kp COMMA &kp DOT  &kp SLASH &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE                 &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };

    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp APOSTROPHE
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };

    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    uml {
      display-name = "UML";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3      &kp N6 &kp N7  &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &trans                                                         &trans   &kp Y  &ue_morph &kp I     &oe_morph  &kp P    &kp BSLH
        &kp ESC   &ae_morph &win_sz  &kp D    &kp F      &kp G  &trans       &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &trans &kp H  &kp J   &kp K     &kp L    &kp SEMI &kp APOSTROPHE
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                                &kp N  &kp M   &kp COMMA &kp DOT  &kp SLASH &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE                 &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >; 
    };

    symb {
      display-name = "SYMB";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3      &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &trans                                                         &trans   &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &paren_brack     &brace_angle    &quote_morph    &macro_bticks      &kp G  &trans       &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &trans &kp H  &ts_console_log  &ts_arrow_fn     &jv_sout    &kp SEMI &kp APOSTROPHE
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                                &kp N  &kp M  &kp COMMA &kp DOT  &kp SLASH &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE                 &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >; 
    };

    mouse {
      display-name = "MOUSE";
      bindings = <
        /* Row 1 (numbers) — unchanged */
        &trans   &trans   &trans  &trans  &trans  &trans  &trans                                    &trans     &trans  &trans  &trans  &trans  &trans  &trans

        /* Row 2 — SCROLL ring above the mover diamond */
        &trans   &trans   &trans  &trans  &trans  &trans  &trans                                    &trans
        &trans
        &msc SCRL_UP        /* U = scroll up    */
        &trans
        &msc SCRL_DOWN      /* O = scroll down  */
        &trans
        &msc SCRL_LEFT      /* [ = scroll left  */
        &msc SCRL_RIGHT     /* ] = scroll right */

        /* Row 3 — POINTER MOVE diamond on J K L I */
        &trans   &trans   &trans  &trans  &trans  &trans  &trans           &trans &trans &trans &trans  &trans
        &mmv MOVE_LEFT      /* H = move left  */
        &mmv MOVE_DOWN      /* J = move down  */
        &mmv MOVE_UP        /* K = move up    */
        &mmv MOVE_RIGHT     /* L = move right */
        &mkp LCLK           /* ; = left click */
        &mkp RCLK           /* ' = right click */

        /* Row 4 — middle click handy on Slash; keep your nav column as-is */
        &trans   &trans   &trans  &trans  &trans  &trans                       &trans  &trans
        /* right-hand */
        &trans  &trans  &trans  &trans  &mkp MCLK  /* / = middle click */
        &trans

        /* Row 5 — leave thumbs and edges alone (inherits Base) */
        &trans   &trans   &trans  &trans  &trans                 &trans &trans &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans
      >;
    };

    nav { 
      display-name = "NAV";    
      status = "reserved";
    };
  };
};
